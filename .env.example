# -----------------------------------------------------------------------------
# African Tutors — Environment Variables (example)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# NEVER commit `.env.local` or any file containing real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Anything without that prefix is server-only and must never be referenced
# from Client Components.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Base URL of the deployed app. Used for auth redirects, links in emails, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth + PostgreSQL) -------------------------------------------
# Safe to expose to the browser: project URL + anon key (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, only use in trusted server-side code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (future payments) -----------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Daily (live tutoring rooms) --------------------------------------------
# Server-only. The API key mints rooms + meeting tokens and must NEVER be
# exposed to the browser (never prefix with NEXT_PUBLIC_). If DAILY_API_KEY /
# DAILY_DOMAIN are missing, booking/payment features keep working and the join
# endpoint returns HTTP 503 "video service unavailable" (nothing crashes).
DAILY_API_KEY=
# Your Daily subdomain (rooms resolve to https://<DAILY_DOMAIN>.daily.co/<room>).
DAILY_DOMAIN=
# Optional. Base64 HMAC secret used to verify Daily webhook authenticity; when
# unset, /api/daily/webhook is disabled (503) and presence is recorded on join.
DAILY_WEBHOOK_SECRET=

# --- Transactional email (verification, password reset, notifications) -----
# Provider to be finalized (e.g. Resend, Postmark, SendGrid). Server-only.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_PROVIDER_API_KEY=
