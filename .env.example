# -----------------------------------------------------------------------------
# African Tutors — Environment Variables (example)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# NEVER commit `.env.local` or any file containing real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Anything without that prefix is server-only and must never be referenced
# from Client Components.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Base URL of the deployed app. Used for auth redirects, links in emails, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth + PostgreSQL) -------------------------------------------
# Safe to expose to the browser: project URL + anon key (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, only use in trusted server-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Direct Postgres connection string used ONLY to apply migrations
# (psql), never by the app runtime. Never expose to the browser.
SUPABASE_DB_URL=

# --- Stripe (payments) ------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only. If STRIPE_SECRET_KEY is missing, checkout/refund routes fail
# safely with HTTP 503 (no charges/refunds attempted); the webhook returns 503
# until STRIPE_WEBHOOK_SECRET is also set. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Daily (live tutoring rooms) --------------------------------------------
# Server-only. The API key mints rooms + meeting tokens and must NEVER be
# exposed to the browser (never prefix with NEXT_PUBLIC_). If DAILY_API_KEY /
# DAILY_DOMAIN are missing, booking/payment features keep working and the join
# endpoint returns HTTP 503 "video service unavailable" (nothing crashes).
DAILY_API_KEY=
# Your Daily subdomain (rooms resolve to https://<DAILY_DOMAIN>.daily.co/<room>).
DAILY_DOMAIN=
# Optional. Base64 HMAC secret used to verify Daily webhook authenticity; when
# unset, /api/daily/webhook is disabled (503). Required to receive recording
# lifecycle events (recording.ready-to-download / recording.error) and presence.
# Register the webhook via Daily REST API (POST /v1/webhooks) — not a dashboard
# toggle. Example:
#   curl -X POST https://api.daily.co/v1/webhooks \
#     -H "Authorization: Bearer $DAILY_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://YOUR_APP/api/daily/webhook","eventTypes":["recording.ready-to-download","recording.error","participant.joined","participant.left"],"hmac":"<base64-secret>","retryType":"exponential"}'
# Store the same base64 hmac as DAILY_WEBHOOK_SECRET. Do not auto-register from
# the app during normal request handling.
DAILY_WEBHOOK_SECRET=
# --- Optional: custom private S3 recording storage (Mode B) -----------------
# Leave ALL THREE blank for Mode A (Daily-managed storage, the V1 default). When
# all are set, Daily writes cloud recordings to your private bucket via an
# assume-role ARN (no AWS secret keys are used or stored here). Server-only.
DAILY_S3_BUCKET_NAME=
DAILY_S3_REGION=
DAILY_S3_ASSUME_ROLE_ARN=

# --- Transactional email: Resend (booking/payment/session/dispute + reminders) --
# Server-only. If RESEND_API_KEY is unset, email runs in STUB mode (logged, not
# sent) and NEVER blocks any business operation (see src/lib/email/transport.ts).
RESEND_API_KEY=
# Sender identity. Use a verified domain sender in production, e.g.
# "Study Hall at Home <notifications@yourdomain.com>". Do not set a production
# sender until domain verification is complete.
EMAIL_FROM="Study Hall at Home <notifications@example.com>"
# Optional. Svix "whsec_..." secret to verify Resend delivery webhooks
# (delivered/bounced) at /api/resend/webhook; when unset that endpoint is 503.
RESEND_WEBHOOK_SECRET=
# Optional. Where operational alert emails go (Call Parent failure, recording
# failure, overdue Guide reports, etc.). When unset, admin alerts are skipped.
ADMIN_ALERT_EMAIL=
# NEXT_PUBLIC_APP_URL (above) is used to build authenticated session links in
# emails (APP_URL/dashboard/session/<booking_id>) — never a Daily room URL.

# --- Call Parent: Twilio Voice + SMS (Study Hall PR7) + parent 1h SMS (PR8) ---
# Server-only. Never prefix with NEXT_PUBLIC_. If any of these are missing,
# Call Parent fails safely (Guide sees "Unable to contact parent — notify
# manager") and never claims a successful call. Parent 1h reminder SMS is
# skipped (email still sent). The agent cannot buy numbers or change Twilio
# account settings — configure these in Vercel after merge.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 Twilio number enabled for Voice + SMS (e.g. +15551234567).
TWILIO_PHONE_NUMBER=
# Status callbacks are registered programmatically on each outbound call as:
#   POST {NEXT_PUBLIC_APP_URL}/api/twilio/voice-status
# Ensure NEXT_PUBLIC_APP_URL is your public HTTPS origin so Twilio can reach it
# and signature validation matches. No Twilio Console webhook is required when
# StatusCallback is set on the Call create request (recommended).
# Calls use MachineDetection=DetectMessageEnd; AnsweredBy=human is required for
# "Parent contacted". Voicemail/machine/unknown AMD still get SMS fallback once.
#
# US A2P 10DLC: for reliable production delivery of parent reminder / cancel /
# reassignment SMS to US numbers, complete Twilio A2P 10DLC brand + campaign
# registration. Do not bypass carrier compliance. Call Parent and transactional
# SMS share this number/campaign.

# --- Scheduled jobs (Vercel Cron + shared secret) ---------------------------
# Server-only shared secret protecting:
#   - GET/POST /api/cron/reminders  (PR8: 1h parent+Guide reminders, report nudges)
#   - GET/POST /api/cron/recording-retention (PR9: Daily delete after 60 days)
#   - /api/admin/cron/release-expired
# If unset, those endpoints return 503. Vercel Cron is configured in vercel.json:
#   /api/cron/reminders every 15 minutes
#   /api/cron/recording-retention daily at 09:00 UTC (0 9 * * *)
# Vercel sends Authorization: Bearer <CRON_SECRET> when CRON_SECRET is set.
CRON_SECRET=
